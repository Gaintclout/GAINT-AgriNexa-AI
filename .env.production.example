# Copy to .env.production on the host. Never commit the real file.
AGRINEXA_IMAGE_TAG=replace-with-immutable-release-tag
AGRINEXA_ENV=production
DATABASE_URL=postgresql+psycopg://least_privilege_app_user:REPLACE@private-db-host:25060/agrinexa?sslmode=require
AGRINEXA_JWT_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_BYTES
AGRINEXA_CORS_ORIGINS=https://agrinexa.example.com
AGRINEXA_APPROVED_DATASET_DIR=/srv/agrinexa/approved-datasets
# Container paths only; leave blank until a human-approved artifact exists.
AGRINEXA_MARKET_SNAPSHOT_PATH=
AGRINEXA_SCHEME_CATALOGUE_PATH=
